# =========================
# Backend Spring local env
# Copy file này thành .env hoặc export từng biến trước khi chạy app
# =========================

# Database
DB_URL=jdbc:postgresql://localhost:15432/amomeal
DB_USERNAME=postgres
DB_PASSWORD=postgres

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=16379
REDIS_TIMEOUT=3s
REDIS_CONNECT_TIMEOUT=3s

# Server
SERVER_PORT=8000

# CORS / frontend
CORS_ALLOWED_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# JWT / auth
AUTH_JWT_SECRET=dev-only-insecure-secret-change-me
AUTH_ACCESS_TOKEN_EXPIRES_IN=15
AUTH_REFRESH_TOKEN_EXPIRES_IN=43200
AUTH_REFRESH_TOKEN_PEPPER=dev-only-insecure-secret-change-me

# Storage
ATTACHMENT_STORAGE_BACKEND=local
ATTACHMENT_LOCAL_ROOT=./media
ATTACHMENT_PUBLIC_BASE_URL=http://localhost:8000/media
ATTACHMENT_UPLOAD_BASE_URL=http://localhost:8000/api/attachments

# Optional S3 config (used when ATTACHMENT_STORAGE_BACKEND=s3)
S3_ACCESS_KEY_ID=test
S3_SECRET_ACCESS_KEY=test
S3_BUCKET_NAME=amomeal-attachments
S3_REGION=ap-southeast-1
S3_PUBLIC_URL=
S3_EXPIRES_IN=3600
S3_ENDPOINT_OVERRIDE=

# Mail (dev mode: can leave blank, app logs OTP instead of sending real email)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# PayOS
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
PAYOS_PAYOUT_CLIENT_ID=
PAYOS_PAYOUT_API_KEY=
PAYOS_PAYOUT_CHECKSUM_KEY=
PAYOS_API_URL=https://api-merchant.payos.vn
PAYOS_BASE_URL=https://api-merchant.payos.vn
PAYOS_RETURN_URL=
PAYOS_CANCEL_URL=

# Wallet / payment
WALLET_CHAIN_SECRET=
PAYMENT_EVENT_SECRET=${AUTH_JWT_SECRET}
PAYMENT_RECONCILIATION_ENABLED=true
PAYMENT_RECONCILIATION_INTERVAL=PT60S
PAYMENT_RECONCILIATION_MIN_AGE=PT2M
PAYMENT_RECONCILIATION_MAX_AGE=PT24H
PAYMENT_RECONCILIATION_BATCH_SIZE=50

# AI / Gemini
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com
AI_MODEL_BASE_URL=http://localhost:8001
AI_MODEL_TIMEOUT_SECONDS=10

# Recommendation
RECOMMENDATION_CANDIDATE_POOL_SIZE=300
RECOMMENDATION_CANDIDATE_MAX_PER_CATEGORY=0
RECOMMENDATION_USE_PGVECTOR_ANN_CANDIDATES=false
RECOMMENDATION_HISTORY_DECAY_LAMBDA=0.03
RECOMMENDATION_RECENCY_DECAY_LAMBDA=0.02
RECOMMENDATION_FAVORITE_RECENCY_DECAY_LAMBDA=0.03
RECOMMENDATION_USER_VECTOR_EMA_ALPHA=0.35
RECOMMENDATION_DIET_BALANCED_TARGET_PROTEIN=0.3
RECOMMENDATION_DIET_BALANCED_TARGET_FAT=0.3
RECOMMENDATION_DIET_BALANCED_TARGET_CARB=0.4
RECOMMENDATION_MMR_LAMBDA=0.5
RECOMMENDATION_USE_PGVECTOR_SIMILARITY=false
RECOMMENDATION_PENALTY_GAMMA=0.25
RECOMMENDATION_PENALTY_CORRELATION_THRESHOLD=0.35
RECOMMENDATION_DISH_MATCH_THRESHOLD=0.6

# Verification / report
VERIFICATION_S3_DELETION_ENABLED=true
VERIFICATION_S3_DELETION_CRON=0 0 3 * * *
REPORT_PRESERVE_ORDER_UUID_BUG=false
ADMIN_ALERT_EMAIL=

# Stock / Redis
STOCK_HOLD_TTL_SECONDS=900
STOCK_REDIS_DATABASE=1
STOCK_SWEEP_ENABLED=true
STOCK_SWEEP_BATCH_SIZE=500
STOCK_REDIS_URL=
STOCK_REDIS_SENTINELS=
STOCK_REDIS_SENTINEL_MASTER=mymaster
STOCK_REDIS_PASSWORD=
STOCK_REDIS_SOCKET_TIMEOUT=0.3
STOCK_REDIS_BREAKER_FAIL_MAX=3
STOCK_REDIS_BREAKER_RESET_SECONDS=10

# Order outbox
OUTBOX_DISPATCH_ENABLED=true
OUTBOX_DISPATCH_INTERVAL=PT30S
OUTBOX_MAX_ATTEMPTS=10
OUTBOX_BACKOFF_BASE_SECONDS=5
OUTBOX_BACKOFF_MAX_SECONDS=300
OUTBOX_SWEEP_BATCH_SIZE=100

# Certificates / tracking / review flags
CERTIFICATE_PRESERVE_APPROVED_STATUS_BUG=false
TRACKING_PRESERVE_WS_ROUTE_BUG=false
TRACKING_PRESERVE_ORDER_TRACKING_BUG=false
TRACKING_PRESERVE_ZERO_AVG_RATING_BUG=true
GEMINI_PRESERVE_RECIPE_TIMEOUT_BUG=false
PAYMENT_PRESERVE_DJANGO_CONFIRM_OUTCOME_BUG=false
REPORT_PRESERVE_ORDER_UUID_BUG=false
